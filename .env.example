# Copy this file to .env.local for local development, and add the same
# variables in Vercel (Project → Settings → Environment Variables).
# All are public: they are sent to every browser. Never put the Supabase
# secret key (service_role) in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://vfipnxfyzhldhryyrcwe.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_OnVPES1NytTukf4DxMvhDg_rgOaPtnm
# The live-tracking map's tiles (MapTiler API key; see README, "Live tracking").
# Without it, the map uses OpenStreetMap's tiles, which are fine for development.
NEXT_PUBLIC_MAPTILER_KEY=
